<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- System tray icon support via System.Windows.Forms.NotifyIcon -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.45.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- Embed config templates so published single-file EXE can bootstrap first-run configs -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.template.json">
      <LogicalName>appsettings.template.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="speech_language_config.template.json">
      <LogicalName>speech_language_config.template.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="configs\prompts.template.yaml">
      <LogicalName>prompts.template.yaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Do not compile sample code as part of the main app project -->
  <ItemGroup>
    <Compile Remove="samples\**\*.cs" />
    <None Include="samples\**\*" />
  </ItemGroup>

</Project>
