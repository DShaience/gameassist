{
  "Provider": "OpenAI",
  
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-4o",
    "Organization": ""
  },
  
  "AzureOpenAI": {
    "Endpoint": "https://your-resource.openai.azure.com",
    "ApiKey": "YOUR_AZURE_OPENAI_API_KEY_HERE",
    "DeploymentName": "gpt-4o"
  },
  
  "Translation": {
    "TargetLanguage": "Hebrew",
    "Mode": "explain",
    "RetryAttempts": 2,
    "TimeoutSeconds": 30
  },
  
  "Hotkeys": {
    "Translate": "Ctrl+Alt+T",
    "AskQuestion": "Ctrl+Alt+Q",
    "ToggleMode": "Ctrl+Alt+S",
    "StopSpeaking": "Ctrl+Alt+X"
  },
  
  "Audio": {
    "DuckingEnabled": true,
    "DuckVolumePercent": 25,
    "DuckDurationMs": 300,
    "TTSVoice": "alloy",
    "TTSSpeed": 1.0
  },
  
  "ScreenCapture": {
    "DownscaleWidth": 640,
    "SignatureHashAlgorithm": "xxHash64"
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "GameScreenTranslator": "Debug"
    },
    "LogFilePath": "logs/interactions.jsonl",
    "IncludeScreenshotsInDebug": true
  }
}
