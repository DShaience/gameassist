{
  "Providers": {
    "AzureFoundry": {
      "Endpoint": "YOUR_AZURE_FOUNDRY_ENDPOINT",
      "ApiKey": "YOUR_AZURE_FOUNDRY_API_KEY",
      "ApiVersion": "2025-04-01-preview",

      "LLM": {
        "ChatDeployment": "gpt-5.2-chat",
        "VisionDeployment": "gpt-5.2-chat",
        "RetryAttempts": 2,
        "TimeoutSeconds": 30
      }
    }
  },

  "Hotkeys": {
    "Translate": "Ctrl+Alt+T",
    "Ask": "Ctrl+Alt+W",
    "Stop": "Ctrl+Alt+X",
    "ResetConversation": "Ctrl+Alt+R"
  },

  "Audio": {
    "DuckingEnabled": true,
    "DuckVolumePercent": 25,
    "DuckDurationMs": 300
  },

  "ScreenCapture": {
    "DownscaleWidth": 640,
    "SignatureHashAlgorithm": "xxHash64"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "GameScreenTranslator": "Debug"
    }
  },

  "InteractionLogging": {
    "LogFilePath": "logs/interactions.jsonl",
    "IncludeScreenshotsInDebug": true
  },

  "Conversation": {
    "Enabled": true,
    "MaxVerbatimTurns": 10,
    "SummaryMaxChars": 1200,
    "Logging": {
      "IncludeContextInDebug": false
    }
  }
}
