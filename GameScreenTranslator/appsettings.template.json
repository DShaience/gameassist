{
  "Providers": {
    "AzureFoundry": {
      "Endpoint": "https://YOUR-FOUNDRY-RESOURCE-NAME.YOUR-REGION.inference.ai.azure.com",
      "ApiKey": "YOUR_AZURE_FOUNDRY_API_KEY_HERE",
      "ApiVersion": "2024-10-21",

      "LLM": {
        "ChatDeployment": "YOUR_CHAT_DEPLOYMENT_NAME",
        "VisionDeployment": "YOUR_VISION_DEPLOYMENT_NAME",
        "RetryAttempts": 2,
        "TimeoutSeconds": 30
      }
    },

    "AzureSpeech": {
      "ConfigPath": "speech_language_config.json"
    }
  },

  "Translation": {
    "TargetLanguage": "Hebrew",
    "Mode": "explain"
  },

  "Hotkeys": {
    "Translate": "Ctrl+Alt+T",
    "AskQuestion": "Ctrl+Alt+Q",
    "ToggleMode": "Ctrl+Alt+S",
    "StopSpeaking": "Ctrl+Alt+X"
  },

  "Audio": {
    "DuckingEnabled": true,
    "DuckVolumePercent": 25,
    "DuckDurationMs": 300,
    "TTSSpeed": 1.0,

    "FallbackMessagesByLanguage": {
      "Hebrew": "סליחה, הייתה בעיה. נסו שוב.",
      "Russian": "Извините, произошла ошибка. Попробуйте еще раз.",
      "en-US": "Sorry, something went wrong. Please try again."
    },
    "CaptureFailedMessage": "לא הצלחתי לצלם את המסך של המשחק הזה.",
    "GenericErrorMessageKey": "Hebrew"
  },

  "ScreenCapture": {
    "DownscaleWidth": 640,
    "SignatureHashAlgorithm": "xxHash64"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "GameScreenTranslator": "Debug"
    }
  },

  "InteractionLogging": {
    "LogFilePath": "logs/interactions.jsonl",
    "IncludeScreenshotsInDebug": true
  }
}
